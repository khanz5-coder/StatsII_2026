d_value <- max(abs(empiricalCDF - pnorm(data))) #test statistic
#Creating the Function
NormKSp <- function(d, k = 100) { #initializing the function with a d-value and a k-value
i <- 1:k #taking a vectorized approach instead of a loop for calculating the terms
terms <- exp(-((2*i - 1)^2) * pi^2)/(8*(d^2)) #calculating the terms for all 100 k's
d_obs <- sqrt(2 * pi)/d * sum(terms) #calculating the observation
return(d_obs)
}
d_obs
