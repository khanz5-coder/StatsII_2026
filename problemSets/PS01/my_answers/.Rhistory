linear.lik <- function(theta, y, X) {
n <-  nrow(X)
k <- ncol(X)
beta <- theta[1:k]
sigma2 <- theta[k+1]^2
e <- y - X%*%beta
logl <- -.5*n*log(2*pi)-.5*n*log(sigma2) - ( (t(e) %*%e)/ (2*sigma2) )
return(-logl)
}
