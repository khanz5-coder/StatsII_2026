library(tidyverse)
library(forecast)
library(zoo)
library(ggplot2)
library(fpp2)
set.seed(123)
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
usmn <- read.csv("usmelec.csv")
usts <- ts(usmn$val, start = c(1973), end = c(2013, 4), frequency = 12)
plot(usts, xlab = "Month",
ylab = "Monthly total net generation",
main = "Monthly Total Net Generation in US From 1973-2013")
usts %>%
stl(s.window = 14, t.window=2) %>%
autoplot()
plot(remainder(fit), main = "Remainder")
usts.sa <- trendcycle(fit)
usa.ses <- ses(usts.sa,
alpha = 0.05, # alpha can be set manually
h = 12)
autoplot(usa.ses)
checkresiduals(usa.ses) # the checkresiduals() function in forecast provides useful plots of residuals, as well as the Ljung-Box test statistic.
autoplot(usa.ses) +
autolayer(fitted(usa.ses))
fit <- ses(usts, h = 12)
usts.sa <- trendcycle(fit)
usts.sa <- trendcycle(usts)
fit <- stl(usts, s.window = 7)
usts.sa <- trendcycle(fit)
usa.ses <- ses(usts.sa,
alpha = 0.05, # alpha can be set manually
h = 12)
autoplot(usa.ses)
fit <- stl(usts, s.window = 7)
usts %>%
stl(s.window = 14, t.window=2) %>%
autoplot()
plot(remainder(fit), main = "Remainder")
# remove objects
rm(list=ls())
# detach all libraries
detachAllPackages <- function() {
basic.packages <- c("package:stats", "package:graphics", "package:grDevices", "package:utils", "package:datasets", "package:methods", "package:base")
package.list <- search()[ifelse(unlist(gregexpr("package:", search()))==1, TRUE, FALSE)]
package.list <- setdiff(package.list, basic.packages)
if (length(package.list)>0)  for (package in package.list) detach(package,  character.only=TRUE)
}
# remove objects
rm(list=ls())
# detach all libraries
detachAllPackages <- function() {
basic.packages <- c("package:stats", "package:graphics", "package:grDevices", "package:utils", "package:datasets", "package:methods", "package:base")
package.list <- search()[ifelse(unlist(gregexpr("package:", search()))==1, TRUE, FALSE)]
package.list <- setdiff(package.list, basic.packages)
if (length(package.list)>0)  for (package in package.list) detach(package,  character.only=TRUE)
}
detachAllPackages()
# load libraries
pkgTest <- function(pkg){
new.pkg <- pkg[!(pkg %in% installed.packages()[,  "Package"])]
if (length(new.pkg))
install.packages(new.pkg,  dependencies = TRUE)
sapply(pkg,  require,  character.only = TRUE)
}
lapply(c("nnet", "MASS"),  pkgTest)
